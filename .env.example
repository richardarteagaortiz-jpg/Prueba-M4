# ============================================================================
# CosmoMates · configuración del servidor con donaciones (NowPayments)
# Copia este archivo a `.env` y rellena tus datos:
#     cp .env.example .env
# `.env` está en .gitignore: NUNCA se sube al repositorio.
# ============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=3000
# URL pública del sitio (necesaria para success_url y para el webhook IPN).
# En producción debe ser HTTPS, por ejemplo: https://cosmomates.example.com
PUBLIC_URL=http://localhost:3000

# --- NowPayments ------------------------------------------------------------
# Clave de API del panel de NowPayments (API keys).
# Permisos recomendados: solo pagos/facturas. Genera una clave nueva: si alguna
# vez se compartió por chat o en un commit, revócala y crea otra.
NOWPAYMENTS_API_KEY=

# Secreto de IPN (panel → Store settings → IPN). Permite verificar que los
# webhooks vienen de NowPayments (HMAC SHA-512). Sin él no se confirman pagos.
NOWPAYMENTS_IPN_SECRET=

# Opcional: cambiar solo para pruebas contra un mock
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1

# --- Donaciones -------------------------------------------------------------
PAY_CURRENCY=usd
PAY_AMOUNTS=5,10,25,50
PAY_MIN_AMOUNT=1
PAY_MAX_AMOUNT=100
